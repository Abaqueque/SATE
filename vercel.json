{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "sky-atlas/dist",
  "functions": {
    "api/cutout.js": {
      "maxDuration": 60
    },
    "api/frame.js": {
      "maxDuration": 60
    },
    "api/observations.js": {
      "maxDuration": 60
    },
    "api/frame-info.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
